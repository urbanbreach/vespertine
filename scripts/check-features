#!/usr/bin/env python3
"""Check FEATURES.md: every row's verifiers exist and pass.

Usage: scripts/check-features [--spec ID ...] [--file FILE] [--no-run-examples] [--example-seconds N]

Rows (under a `## <AREA>` section, header `| Spec | Acceptance | Verified by |`):

    | RND-001 | A1, A2 | test:<crate>:<test name> ; example:<crate>:<example name> |

* `test:<crate>:<name>` must exist in a test executable of the crate (all test executables are built
  once with `cargo test --workspace --no-run`, or only the needed crates when `--spec` is given),
  must not be `#[ignore]`d, and must pass (`<executable> --exact <names...>`, which must also exit 0).
* `example:<crate>:<name>` is built (dev profile) and run for 10 s in the current graphical
  session; it passes if it exits 0 or is still running at the timeout. Examples that verify painted
  frames need a display that delivers frame callbacks, and a compositor sends none to a blanked
  (DPMS-off) monitor, so under Hyprland the monitors are woken before every example.
  `--no-run-examples` builds the examples without launching them (used by `scripts/land`, so no
  windows open).

Exits 0 iff every selected row passes (empty tables pass).
"""

import argparse
import glob
import json
import os
import re
import signal
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HEADER = ["spec", "acceptance", "verified by"]
SPEC_RE = re.compile(r"^([A-Z0-9]+)-\d{3}$")
AREAS = ["RND", "TXT", "LAY", "ELM", "CMP", "INP", "PLT", "ANM", "THM", "PRF", "APP", "A11Y", "DEV"]


def wake_display():
    """Wakes blanked Hyprland monitors; a no-op elsewhere. A blanked monitor gets no frame callbacks,
    so windows on it never repaint after their first frame."""
    env = dict(os.environ)
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        instances = sorted(glob.glob(f"/run/user/{os.getuid()}/hypr/*/"))
        if not instances:
            return
        env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(instances[-1].rstrip("/"))

    def hyprctl(*args):
        try:
            return subprocess.run(["hyprctl", *args], env=env, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            return None

    def blanked():
        result = hyprctl("monitors")
        return result is not None and "dpmsStatus: 0" in result.stdout

    if not blanked():
        return
    print("== waking the blanked display (examples need frame callbacks)", flush=True)
    # Hyprland with the Lua configuration takes a dispatcher expression, older versions a name.
    for dispatch in (['hl.dsp.dpms({ action = "on" })'], ["dpms", "on"]):
        hyprctl("dispatch", *dispatch)
        if not blanked():
            return
    print("check-features: the display stays blanked; examples that need frames may fail", file=sys.stderr)


class Row:
    def __init__(self, line_no, spec, acceptance, verifiers):
        self.line_no = line_no
        self.spec = spec
        self.acceptance = acceptance
        self.verifiers = verifiers  # list of (kind, crate, name)
        self.errors = []


def fail_usage(message):
    print(f"check-features: {message}", file=sys.stderr)
    sys.exit(1)


def parse_features(path):
    rows, problems = [], []
    area = None
    in_table = False
    with open(path, encoding="utf-8") as handle:
        lines = handle.read().splitlines()
    for number, line in enumerate(lines, 1):
        stripped = line.strip()
        heading = re.match(r"^##\s+(\S+)\s*$", stripped)
        if heading:
            area = heading.group(1)
            in_table = False
            continue
        if not stripped.startswith("|"):
            in_table = False
            continue
        if area is None:
            continue
        cells = [cell.strip() for cell in stripped.strip("|").split("|")]
        if not in_table:
            if [cell.lower() for cell in cells] != HEADER:
                problems.append(f"FEATURES.md:{number}: expected header `| Spec | Acceptance | Verified by |`")
            in_table = True
            continue
        if all(re.fullmatch(r":?-{3,}:?", cell) for cell in cells):
            continue
        if len(cells) != 3:
            problems.append(f"FEATURES.md:{number}: row needs exactly 3 cells")
            continue
        spec, acceptance, verified = cells
        match = SPEC_RE.match(spec)
        if not match:
            problems.append(f"FEATURES.md:{number}: `{spec}` is not a spec ID")
            continue
        if area in AREAS and match.group(1) != area:
            problems.append(f"FEATURES.md:{number}: {spec} is listed under section {area}")
            continue
        if not acceptance:
            problems.append(f"FEATURES.md:{number}: {spec} lists no acceptance items")
            continue
        verifiers = []
        for part in verified.split(";"):
            part = part.strip()
            fields = part.split(":", 2)
            if len(fields) != 3 or fields[0] not in ("test", "example") or not all(f.strip() for f in fields):
                problems.append(f"FEATURES.md:{number}: bad verifier `{part}` (want test:<crate>:<name> or example:<crate>:<name>)")
                verifiers = None
                break
            verifiers.append(tuple(f.strip() for f in fields))
        if verifiers is not None:
            if not verifiers:
                problems.append(f"FEATURES.md:{number}: {spec} has no verifier")
            else:
                rows.append(Row(number, spec, acceptance, verifiers))
    return rows, problems


def run(cmd, **kwargs):
    return subprocess.run(cmd, cwd=ROOT, **kwargs)


def cargo_metadata():
    result = run(["cargo", "metadata", "--format-version", "1", "--no-deps"], capture_output=True, text=True)
    if result.returncode != 0:
        fail_usage("cargo metadata failed:\n" + result.stderr)
    return json.loads(result.stdout)


def build_test_executables(package_args, packages_by_id):
    """Builds every test target; returns {package name: [executable paths]} or None on failure."""
    command = ["cargo", "test", *package_args, "--no-run", "--message-format=json-render-diagnostics"]
    print("== building tests: " + " ".join(command[:-1]), flush=True)
    process = subprocess.Popen(command, cwd=ROOT, stdout=subprocess.PIPE, text=True)
    executables = {}
    for line in process.stdout:
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if message.get("reason") != "compiler-artifact" or not message.get("executable"):
            continue
        if not message.get("profile", {}).get("test"):
            continue
        package = packages_by_id.get(message["package_id"])
        if package is not None:
            executables.setdefault(package["name"], []).append(message["executable"])
    if process.wait() != 0:
        return None
    return executables


def list_tests(executable, manifest_dir, *extra):
    result = subprocess.run(
        [executable, "--list", "--format", "terse", *extra],
        cwd=manifest_dir, env=test_env(manifest_dir), capture_output=True, text=True,
    )
    if result.returncode != 0:
        return None
    return {line[: -len(": test")] for line in result.stdout.splitlines() if line.endswith(": test")}


def test_env(manifest_dir):
    env = dict(os.environ)
    env["CARGO_MANIFEST_DIR"] = manifest_dir
    return env


def check_tests(rows, packages, no_filter):
    """Runs every `test:` verifier; records errors on rows."""
    wanted = {}  # crate -> name -> rows
    for row in rows:
        for kind, crate, name in row.verifiers:
            if kind == "test":
                wanted.setdefault(crate, {}).setdefault(name, []).append(row)
    if not wanted:
        return
    for crate, names in wanted.items():
        if crate not in packages:
            for rows_of_name in names.values():
                for row in rows_of_name:
                    row.errors.append(f"unknown crate `{crate}`")
    known = {crate: names for crate, names in wanted.items() if crate in packages}
    if not known:
        return
    packages_by_id = {package["id"]: package for package in packages.values()}
    package_args = ["--workspace"] if no_filter else [arg for crate in sorted(known) for arg in ("-p", crate)]
    executables = build_test_executables(package_args, packages_by_id)
    if executables is None:
        for names in known.values():
            for rows_of_name in names.values():
                for row in rows_of_name:
                    row.errors.append("test build failed")
        return
    for crate, names in sorted(known.items()):
        manifest_dir = os.path.dirname(packages[crate]["manifest_path"])
        found = {name: [] for name in names}  # name -> executables that list it
        ignored = set()
        for executable in executables.get(crate, []):
            listed = list_tests(executable, manifest_dir)
            if listed is None:
                for rows_of_name in names.values():
                    for row in rows_of_name:
                        row.errors.append(f"`{executable} --list` failed")
                continue
            ignored_here = list_tests(executable, manifest_dir, "--ignored") or set()
            for name in names:
                if name in listed:
                    found[name].append(executable)
                    if name in ignored_here:
                        ignored.add(name)
        per_executable = {}
        for name, exes in found.items():
            if not exes:
                for row in names[name]:
                    row.errors.append(f"test `{crate}:{name}` does not exist")
            elif name in ignored:
                for row in names[name]:
                    row.errors.append(f"test `{crate}:{name}` is #[ignore]d")
            else:
                for executable in exes:
                    per_executable.setdefault(executable, []).append(name)
        for executable, selected in per_executable.items():
            print(f"== running {len(selected)} test(s) of {crate} ({os.path.basename(executable)})", flush=True)
            outcome = subprocess.run(
                [executable, "--exact", *selected],
                cwd=manifest_dir, env=test_env(manifest_dir), capture_output=True, text=True,
            )
            sys.stdout.write(outcome.stdout)
            sys.stderr.write(outcome.stderr)
            results = {}
            for line in outcome.stdout.splitlines():
                match = re.match(r"^test (.+) \.\.\. (\w+)", line)
                if match:
                    results.setdefault(match.group(1), []).append(match.group(2))
            for name in selected:
                states = results.get(name, [])
                clean = bool(states) and all(state == "ok" for state in states)
                if clean and outcome.returncode == 0:
                    continue
                reason = "did not run" if not states else "/".join(sorted(set(states)))
                if outcome.returncode != 0:
                    # An executable that aborts or fails in teardown after printing `ok` lines has
                    # not verified anything.
                    reason += f" ({os.path.basename(executable)} exited with status {outcome.returncode})"
                for row in names[name]:
                    row.errors.append(f"test `{crate}:{name}` {reason}")


def check_examples(rows, packages, target_directory, seconds, run_examples):
    needed = {}  # (crate, example) -> rows
    for row in rows:
        for kind, crate, name in row.verifiers:
            if kind == "example":
                needed.setdefault((crate, name), []).append(row)
    if not needed:
        return
    failures = {}
    buildable = []
    features = []
    for (crate, name) in needed:
        package = packages.get(crate)
        if package is None:
            failures[(crate, name)] = "belongs to an unknown crate"
            continue
        target = next((t for t in package["targets"] if "example" in t["kind"] and t["name"] == name), None)
        if target is None:
            failures[(crate, name)] = "does not exist"
            continue
        buildable.append((crate, name))
        features += [f"{crate}/{feature}" for feature in target.get("required-features", [])]
    if buildable:
        command = ["cargo", "build"]
        for crate in sorted({crate for crate, _ in buildable}):
            command += ["-p", crate]
        for name in sorted({name for _, name in buildable}):
            command += ["--example", name]
        if features:
            command += ["--features", ",".join(sorted(set(features)))]
        print("== building examples: " + " ".join(command), flush=True)
        if run(command).returncode != 0:
            for key in buildable:
                failures[key] = "failed to build"
            buildable = []
    for crate, name in buildable:
        if run_examples:
            failure = run_example(crate, name, os.path.join(target_directory, "debug", "examples", name), seconds)
            if failure:
                failures[(crate, name)] = failure
    for key, failure in failures.items():
        for row in needed[key]:
            row.errors.append(f"example `{key[0]}:{key[1]}` {failure}")


def run_example(crate, name, binary, seconds):
    """Returns None on success or a failure description."""
    wake_display()
    print(f"== running example {crate}:{name} for {seconds} s", flush=True)
    process = subprocess.Popen([binary], cwd=ROOT, start_new_session=True)
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        code = process.poll()
        if code is not None:
            return None if code == 0 else f"exited with status {code}"
        time.sleep(0.1)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(process.pid, sig)
        except ProcessLookupError:
            break
        try:
            process.wait(timeout=5)
            break
        except subprocess.TimeoutExpired:
            continue
    return None


def main():
    parser = argparse.ArgumentParser(description="Check FEATURES.md rows (see the module docstring).")
    parser.add_argument("--spec", action="append", default=[], metavar="ID", help="only check rows of this spec (repeatable)")
    parser.add_argument("--file", default=os.path.join(ROOT, "FEATURES.md"), help="table file (default: FEATURES.md)")
    parser.add_argument("--no-run-examples", action="store_true", help="build examples but do not launch them")
    parser.add_argument("--example-seconds", type=float, default=10.0, help="run time of each example (default 10)")
    args = parser.parse_args()

    sccache = os.path.expanduser("~/Projects/vespertine-cleanroom/tools/bin/sccache")
    if os.path.exists(sccache):
        os.environ.setdefault("RUSTC_WRAPPER", sccache)
        os.environ.setdefault("SCCACHE_DIR", os.path.expanduser("~/Projects/vespertine-cleanroom/tools/sccache-cache"))
        os.environ.setdefault("SCCACHE_CACHE_SIZE", "80G")

    rows, problems = parse_features(args.file)
    if args.spec:
        known = {row.spec for row in rows}
        for spec in args.spec:
            if spec not in known:
                problems.append(f"--spec {spec}: no row in FEATURES.md")
        rows = [row for row in rows if row.spec in args.spec]
    for problem in problems:
        print(f"error: {problem}", file=sys.stderr)

    if rows:
        metadata = cargo_metadata()
        packages = {package["name"]: package for package in metadata["packages"]}
        check_tests(rows, packages, no_filter=not args.spec)
        check_examples(rows, packages, metadata["target_directory"], args.example_seconds, not args.no_run_examples)

    failed = bool(problems)
    print("\n== FEATURES.md")
    for row in rows:
        status = "FAIL" if row.errors else "PASS"
        failed |= bool(row.errors)
        print(f"{status}  {row.spec}  ({row.acceptance})")
        for error in row.errors:
            print(f"      {error}")
    print(f"{len(rows)} row(s), {'FAILED' if failed else 'ok'}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
