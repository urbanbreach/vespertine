#!/usr/bin/env bash
# Land the current worktree branch (work/<owner>) onto main through the merge train.
#
# Every `./scripts/land` process enqueues its branch (after the usual checks and a local
# `git rebase main`) in .git/land-queue/ and then waits. Whichever waiting process holds the landing
# lock acts as the train leader: it builds a candidate in the persistent integration worktree
# (.worktrees/_land) by starting at main and rebasing the queued branches onto it in FIFO order
# (at most 6 per train; reserved branches first), runs the gates once on the candidate and
# fast-forwards main to it. If the gates fail, the entries are bisected by halves (re-testing exactly
# composed candidates) until the culprits are isolated; culprits are marked `failed` with their gate
# log under .git/land-logs/ and the green remainder lands. A branch that conflicts with main or with
# earlier entries is skipped, marked `conflict` and reserved for 20 minutes: no new train starts
# until the reserved branch has been re-enqueued, and it then goes first.
# Only a candidate that passed the gates as exactly that commit is ever fast-forwarded into main.
#
# Entry status, one line in .git/land-queue/<branch>.status:
#   queued | landed <sha> | landed-dry <sha> | conflict | failed <log>
#
# `--dry-run` does everything except moving main (entries end as `landed-dry`). Test overrides:
# VSP_LAND_MAIN (main checkout), VSP_LAND_LOCK, VSP_LAND_WORKTREE, VSP_LAND_QUEUE, VSP_LAND_LOGS,
# VSP_LAND_POLL (seconds between polls, default 30), VSP_LAND_CAP (train size, default 6),
# VSP_LAND_GATES (shell command run in the candidate checkout instead of the real gates),
# VSP_LAND_RESERVATION_BLOCKS=0 (reserved branches only go first; trains do not wait for them).
#
# The whole script is one function called on the last line: a rebase of the worktree's own branch
# may rewrite this file while it is running, and bash must not read from it afterwards.
set -euo pipefail

MAIN_CHECKOUT="${VSP_LAND_MAIN:-$HOME/Projects/vespertine}"
LAND_WORKTREE="${VSP_LAND_WORKTREE:-$MAIN_CHECKOUT/.worktrees/_land}"
LOCK_FILE="${VSP_LAND_LOCK:-$MAIN_CHECKOUT/.git/vespertine-land.lock}"
RESERVATION_FILE="${LOCK_FILE%.lock}.reserved"
RESERVATION_LOCK="${LOCK_FILE%.lock}.reserved.lock"
QUEUE_DIR="${VSP_LAND_QUEUE:-$MAIN_CHECKOUT/.git/land-queue}"
LOG_DIR="${VSP_LAND_LOGS:-$MAIN_CHECKOUT/.git/land-logs}"
POLL_SECONDS="${VSP_LAND_POLL:-30}"
TRAIN_CAP="${VSP_LAND_CAP:-6}"
RESERVATION_MINUTES=20

export RUSTC_WRAPPER="${RUSTC_WRAPPER:-$HOME/Projects/vespertine-cleanroom/tools/bin/sccache}"
export SCCACHE_DIR="${SCCACHE_DIR:-$HOME/Projects/vespertine-cleanroom/tools/sccache-cache}"
export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-80G}"
export GIT_EDITOR=true

dry_run=0
branch=""
id=""
worktree=""
conflicted=0

# Train state (valid while the lock is held).
declare -A SHA_OF RESULT_OF LOG_OF
MAIN_SHA=""
TRAIN_ID=""
GATE_COUNT=0
SOLVE_G=""
WAIT_FOR_RESERVATION=0
COMPOSED_SHA=""
COMPOSED_IDS=""
APPLIED_SHA=""

die() { echo "land: $*" >&2; exit 1; }
say() { echo "land: $*"; }
now() { date +%s; }
short() { git -C "$MAIN_CHECKOUT" rev-parse --short "$1"; }

# ---- reservations: lines "<branch> <expiry unix seconds>" ---------------------------------------

reserve() {
    (
        flock 8
        tmp="$RESERVATION_FILE.$$"
        {
            if [ -f "$RESERVATION_FILE" ]; then awk -v b="$1" '$1 != b' "$RESERVATION_FILE"; fi
            echo "$1 $(($(now) + RESERVATION_MINUTES * 60))"
        } >"$tmp"
        mv "$tmp" "$RESERVATION_FILE"
    ) 8>"$RESERVATION_LOCK"
}

unreserve() {
    [ -f "$RESERVATION_FILE" ] || return 0
    (
        flock 8
        tmp="$RESERVATION_FILE.$$"
        awk -v b="$1" '$1 != b' "$RESERVATION_FILE" >"$tmp" || true
        mv "$tmp" "$RESERVATION_FILE"
    ) 8>"$RESERVATION_LOCK"
}

# Prints the branches holding an unexpired reservation; removes expired ones.
active_reservations() {
    [ -f "$RESERVATION_FILE" ] || return 0
    (
        flock 8
        tmp="$RESERVATION_FILE.$$"
        awk -v n="$(now)" 'NF >= 2 && $2 + 0 > n + 0' "$RESERVATION_FILE" >"$tmp" || true
        mv "$tmp" "$RESERVATION_FILE"
        awk '{print $1}' "$RESERVATION_FILE"
    ) 8>"$RESERVATION_LOCK"
}

# ---- queue ---------------------------------------------------------------------------------------

esc() { echo "${1//\//__}"; }
entry_get() { sed -n "s/^$2=//p" "$QUEUE_DIR/$1" | head -n 1; }

set_status() {
    printf '%s\n' "$2" >"$QUEUE_DIR/.status.$$"
    mv "$QUEUE_DIR/.status.$$" "$QUEUE_DIR/$1.status"
}

get_status() {
    if [ -f "$QUEUE_DIR/$1.status" ]; then cat "$QUEUE_DIR/$1.status"; else echo gone; fi
}

remove_entry() { rm -f "$QUEUE_DIR/$1" "$QUEUE_DIR/$1.status"; }

enqueue() {
    mkdir -p "$QUEUE_DIR" "$LOG_DIR"
    printf 'branch=%s\nhead=%s\npid=%s\nenqueued=%s\nworktree=%s\n' \
        "$branch" "$(git rev-parse HEAD)" "$$" "$(date +%s%N)" "$worktree" >"$QUEUE_DIR/.entry.$$"
    mv "$QUEUE_DIR/.entry.$$" "$QUEUE_DIR/$id"
    set_status "$id" queued
}

# Entry ids with status `queued`, oldest first.
list_queued() {
    local f name
    for f in "$QUEUE_DIR"/*; do
        [ -f "$f" ] || continue
        name=${f##*/}
        case $name in *.status) continue ;; esac
        [ "$(get_status "$name")" = queued ] || continue
        echo "$(entry_get "$name" enqueued) $name"
    done | sort -n -s -k1,1 | cut -d' ' -f2
}

# Drops entries whose land process is gone (killed or timed out).
purge_dead() {
    local f name pid
    for f in "$QUEUE_DIR"/*; do
        [ -f "$f" ] || continue
        name=${f##*/}
        case $name in *.status) continue ;; esac
        pid=$(entry_get "$name" pid)
        if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
            say "dropping the queue entry of $(entry_get "$name" branch) (its land process is gone)"
            remove_entry "$name"
        fi
    done
    # Statuses without an entry.
    for f in "$QUEUE_DIR"/*.status; do
        [ -f "$f" ] || continue
        [ -f "${f%.status}" ] || rm -f "$f"
    done
}

cleanup() {
    local code=$?
    trap - EXIT
    [ -z "$id" ] || remove_entry "$id"
    if [ "$conflicted" = 0 ] && [ -n "$branch" ]; then unreserve "$branch" 2>/dev/null || true; fi
    exit "$code"
}

# ---- train (leader, lock held) ------------------------------------------------------------------

LW() { git -C "$LAND_WORKTREE" "$@"; }

checkout_clean() {
    LW rebase --abort >/dev/null 2>&1 || true
    LW checkout -q --detach --force "$1"
    LW clean -fdq -e /target
}

mark_conflict() {
    local branch_of
    branch_of=$(entry_get "$1" branch)
    say "$branch_of conflicts with main or an earlier entry of the train; skipped"
    set_status "$1" conflict
    reserve "$branch_of"
}

mark_failed() {
    say "$(entry_get "$1" branch) failed the gates (log: $2)"
    set_status "$1" "failed $2"
}

# apply_entry <candidate sha> <id>: replays the entry's commits (since its merge-base with the
# train's main) onto the candidate; sets APPLIED_SHA. Returns 1 on a conflict.
apply_entry() {
    local head base
    head=$(entry_get "$2" head)
    base=$(git -C "$MAIN_CHECKOUT" merge-base "$head" "$MAIN_SHA") || return 1
    checkout_clean "$head"
    if LW rebase -q --onto "$1" "$base" >/dev/null 2>&1; then
        APPLIED_SHA=$(LW rev-parse HEAD)
    else
        LW rebase --abort >/dev/null 2>&1 || true
        return 1
    fi
}

# compose <base sha> <ids...>: applies the entries in order; entries that conflict are marked and
# dropped. Sets COMPOSED_SHA and COMPOSED_IDS (the ids that were applied).
compose() {
    local sha=$1 entry
    shift
    COMPOSED_IDS=""
    for entry in "$@"; do
        if apply_entry "$sha" "$entry"; then
            sha=$APPLIED_SHA
            COMPOSED_IDS="$COMPOSED_IDS $entry"
        else
            mark_conflict "$entry"
        fi
    done
    COMPOSED_SHA=$sha
    COMPOSED_IDS=${COMPOSED_IDS# }
}

run_gates() {
    if [ -n "${VSP_LAND_GATES:-}" ]; then
        bash -c "$VSP_LAND_GATES"
        return
    fi
    echo "land: gate: cargo fmt --all --check"
    cargo fmt --all --check
    echo "land: gate: cargo clippy --workspace --all-targets -- -D warnings"
    cargo clippy --workspace --all-targets -- -D warnings
    echo "land: gate: cargo test --workspace"
    cargo test --workspace
    echo "land: gate: ./scripts/check-features --no-run-examples"
    ./scripts/check-features --no-run-examples
}

# test_candidate <key> <sha>: runs the gates on exactly this commit; records the result.
test_candidate() {
    local key=$1 sha=$2 log rc start=$SECONDS
    GATE_COUNT=$((GATE_COUNT + 1))
    log="$LOG_DIR/$TRAIN_ID-$GATE_COUNT.log"
    checkout_clean "$sha"
    say "gate run $GATE_COUNT on $(short "$sha") [$key]"
    set +e
    (
        set -e
        cd "$LAND_WORKTREE"
        run_gates
    ) 2>&1 | tee "$log"
    rc=${PIPESTATUS[0]}
    set -e
    LOG_OF["k:$key"]=$log
    if [ "$rc" = 0 ]; then
        RESULT_OF["k:$key"]=green
    else
        RESULT_OF["k:$key"]=red
    fi
    say "gate run $GATE_COUNT: ${RESULT_OF["k:$key"]} after $((SECONDS - start)) s"
}

# solve <green set> <candidates>: adds the candidates to the green set, isolating culprits by
# halves. A set is a space-separated id list; every non-empty set returned in SOLVE_G passed the
# gates as exactly the commit SHA_OF[k:<set>].
solve() {
    local G=$1 C=$2 key sha half H1 H2 G1
    local -a cs
    [ -n "$C" ] || { SOLVE_G=$G; return; }
    key="${G:+$G }$C"
    if [ -z "${SHA_OF["k:$key"]:-}" ]; then
        read -ra cs <<<"$C"
        compose "${SHA_OF["k:$G"]}" "${cs[@]}"
        C=$COMPOSED_IDS
        [ -n "$C" ] || { SOLVE_G=$G; return; }
        key="${G:+$G }$C"
        SHA_OF["k:$key"]=$COMPOSED_SHA
    fi
    sha=${SHA_OF["k:$key"]}
    if [ -z "${RESULT_OF["k:$key"]:-}" ]; then test_candidate "$key" "$sha"; fi
    if [ "${RESULT_OF["k:$key"]}" = green ]; then SOLVE_G=$key; return; fi
    read -ra cs <<<"$C"
    if [ "${#cs[@]}" -eq 1 ]; then
        mark_failed "${cs[0]}" "${LOG_OF["k:$key"]}"
        SOLVE_G=$G
        return
    fi
    half=$(((${#cs[@]} + 1) / 2))
    H1="${cs[*]:0:$half}"
    H2="${cs[*]:$half}"
    solve "$G" "$H1"
    G1=$SOLVE_G
    solve "$G1" "$H2"
}

# Moves main to the tested candidate (or reports it in a dry run). If main moved meanwhile nothing
# is landed and the entries stay queued for the next train.
finalize_train() {
    local final=$1 sha entry main_now log
    [ -n "$final" ] || { say "no entry passed the gates; main unchanged"; return 0; }
    sha=${SHA_OF["k:$final"]}
    main_now=$(git -C "$MAIN_CHECKOUT" rev-parse main)
    if ! git -C "$MAIN_CHECKOUT" merge-base --is-ancestor "$main_now" "$sha"; then
        say "main moved during the gates; the train is rebuilt"
        return 0
    fi
    if [ "$dry_run" = 1 ]; then
        say "dry run: the candidate $(short "$sha") passed the gates; main not modified"
        for entry in $final; do set_status "$entry" "landed-dry $sha"; done
        return 0
    fi
    log="$LOG_DIR/$TRAIN_ID-ff.log"
    if git -C "$MAIN_CHECKOUT" merge --ff-only "$sha" >"$log" 2>&1; then
        say "fast-forwarded main to $(git -C "$MAIN_CHECKOUT" log -1 --format='%h %s' "$sha")"
        for entry in $final; do set_status "$entry" "landed $sha"; done
    else
        say "could not fast-forward main (see $log)"
        for entry in $final; do mark_failed "$entry" "$log"; done
    fi
}

# Builds, tests and lands one train. Sets WAIT_FOR_RESERVATION=1 when a reservation makes the
# leader wait instead (this function always returns 0, so that errexit stays active inside it).
run_train() {
    local -a queued ordered train reserved_branches
    local entry reserved wait_for="" reserved_id
    WAIT_FOR_RESERVATION=0
    purge_dead
    find "$LOG_DIR" -type f -mtime +7 -delete 2>/dev/null || true
    mapfile -t queued < <(list_queued)
    [ "${#queued[@]}" -gt 0 ] || return 0

    mapfile -t reserved_branches < <(active_reservations)
    ordered=()
    for reserved in "${reserved_branches[@]}"; do
        reserved_id=$(esc "$reserved")
        if printf '%s\n' "${queued[@]}" | grep -qxF "$reserved_id"; then
            ordered+=("$reserved_id")
        else
            wait_for="$wait_for $reserved"
        fi
    done
    if [ -n "$wait_for" ] && [ "${VSP_LAND_RESERVATION_BLOCKS:-1}" = 1 ]; then
        say "waiting for the reservation of${wait_for} (it must be re-landed first)"
        WAIT_FOR_RESERVATION=1
        return 0
    fi
    for entry in "${queued[@]}"; do
        if ! printf '%s\n' "${ordered[@]:-}" | grep -qxF "$entry"; then ordered+=("$entry"); fi
    done
    train=("${ordered[@]:0:$TRAIN_CAP}")

    MAIN_SHA=$(git -C "$MAIN_CHECKOUT" rev-parse main)
    TRAIN_ID="$(date +%Y%m%d-%H%M%S)-$$"
    GATE_COUNT=0
    SHA_OF=()
    RESULT_OF=()
    LOG_OF=()
    SHA_OF["k:"]=$MAIN_SHA
    if [ ! -e "$LAND_WORKTREE/.git" ]; then
        git -C "$MAIN_CHECKOUT" worktree prune
        git -C "$MAIN_CHECKOUT" worktree add -q --detach "$LAND_WORKTREE" "$MAIN_SHA"
    fi
    say "train of ${#train[@]} (of ${#queued[@]} queued) on main $(short "$MAIN_SHA"): $(
        for entry in "${train[@]}"; do printf '%s ' "$(entry_get "$entry" branch)"; done
    )"
    solve "" "${train[*]}"
    finalize_train "$SOLVE_G"
}

# ---- one land ---------------------------------------------------------------------------------

main() {
    case "${1:-}" in
        "") ;;
        --dry-run) dry_run=1 ;;
        *) echo "usage: scripts/land [--dry-run]" >&2; exit 2 ;;
    esac

    worktree=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git worktree"
    [ "$worktree" != "$MAIN_CHECKOUT" ] || die "run inside your worktree (.worktrees/<owner>), not the main checkout"
    branch=$(git -C "$worktree" symbolic-ref --short HEAD 2>/dev/null) || die "detached HEAD; check out work/<owner>"
    case "$branch" in
        work/?*) ;;
        *) die "branch is '$branch'; landing requires a work/<owner> branch" ;;
    esac
    [ -z "$(git -C "$worktree" status --porcelain)" ] || die "uncommitted changes; commit them first"
    id=$(esc "$branch")
    cd "$worktree"
    trap cleanup EXIT

    say "rebasing $branch onto main"
    if ! git rebase main; then
        git rebase --abort
        conflicted=1
        reserve "$branch"
        {
            echo "land: rebase onto main has conflicts; the rebase was aborted."
            echo "land: $branch holds a $RESERVATION_MINUTES-minute reservation (other lands wait for it): rebase onto main now (git rebase main), resolve the conflicts, then re-run ./scripts/land."
        } >&2
        exit 1
    fi
    if [ "$(git rev-parse main)" = "$(git rev-parse HEAD)" ]; then
        die "nothing to land: $branch is identical to main"
    fi

    mkdir -p "$(dirname "$LOCK_FILE")"
    exec 9>"$LOCK_FILE"
    enqueue
    say "queued $branch at $(git rev-parse --short HEAD)"

    local status position last_position="" landed_sha
    while :; do
        status=$(get_status "$id")
        case "$status" in
            "landed "*)
                landed_sha=${status#landed }
                say "landed $(git -C "$MAIN_CHECKOUT" log -1 --format='%h %s' "$landed_sha")"
                git rebase main >/dev/null 2>&1 || say "could not rebase $branch onto main; run: git rebase main"
                exit 0
                ;;
            "landed-dry "*)
                say "dry run: ${status#landed-dry } passed the gates as part of its train; nothing was landed"
                exit 0
                ;;
            conflict)
                conflicted=1
                {
                    echo "land: $branch conflicts with main (or with an entry ahead of it in the train) and was skipped."
                    echo "land: it holds a $RESERVATION_MINUTES-minute reservation and goes first in the next train: rebase onto main now (git rebase main), resolve the conflicts, then re-run ./scripts/land."
                } >&2
                exit 1
                ;;
            "failed "*)
                {
                    echo "land: $branch failed the landing gates; log: ${status#failed }"
                    tail -n 40 "${status#failed }" 2>/dev/null || true
                    echo "land: fix the failure, commit, and re-run ./scripts/land."
                } >&2
                exit 1
                ;;
            gone) die "the queue entry of $branch disappeared" ;;
        esac

        if flock -n 9; then
            run_train
            flock -u 9
            if [ "$WAIT_FOR_RESERVATION" = 1 ]; then
                sleep "$POLL_SECONDS"
            elif [ "$(get_status "$id")" = queued ]; then
                sleep 2
            fi
        else
            position=$(list_queued | grep -nxF "$id" | cut -d: -f1 || true)
            if [ "$position" != "$last_position" ]; then
                say "waiting: position ${position:-?} in the queue; another land is running a train"
                last_position=$position
            fi
            sleep "$POLL_SECONDS"
        fi
    done
}

main "$@"; exit $?
