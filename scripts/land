#!/usr/bin/env bash
# Land the current worktree branch (work/<owner>) onto main.
#
# Takes the exclusive landing lock shared by all worktrees, rebases the branch onto main, runs the
# landing gates on the rebased commit in one persistent integration worktree
# (.worktrees/_land, so consecutive lands build incrementally in the same path), fast-forwards main
# in the main checkout and prints the landed commit.
#
# `--dry-run` does everything except the final fast-forward of main (for testing this script);
# `VSP_LAND_LOCK` and `VSP_LAND_WORKTREE` override the lock file and integration worktree for such tests.
#
# A land whose rebase conflicts aborts the rebase and reserves the next landing for its branch for
# 20 minutes (`<lock file>` with `.reserved` instead of `.lock`); other lands wait for an unexpired
# reservation, so a conflicted owner can resolve and re-run without queueing again.
set -euo pipefail

dry_run=0
case "${1:-}" in
    "") ;;
    --dry-run) dry_run=1 ;;
    *) echo "usage: scripts/land [--dry-run]" >&2; exit 2 ;;
esac

MAIN_CHECKOUT="$HOME/Projects/vespertine"
LAND_WORKTREE="${VSP_LAND_WORKTREE:-$MAIN_CHECKOUT/.worktrees/_land}"
LOCK_FILE="${VSP_LAND_LOCK:-$MAIN_CHECKOUT/.git/vespertine-land.lock}"

export RUSTC_WRAPPER="$HOME/Projects/vespertine-cleanroom/tools/bin/sccache"
export SCCACHE_DIR="$HOME/Projects/vespertine-cleanroom/tools/sccache-cache"
export SCCACHE_CACHE_SIZE=80G

die() { echo "land: $*" >&2; exit 1; }

worktree=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git worktree"
[ "$worktree" != "$MAIN_CHECKOUT" ] || die "run inside your worktree (.worktrees/<owner>), not the main checkout"
branch=$(git -C "$worktree" symbolic-ref --short HEAD 2>/dev/null) || die "detached HEAD; check out work/<owner>"
case "$branch" in
    work/?*) ;;
    *) die "branch is '$branch'; landing requires a work/<owner> branch" ;;
esac
[ -z "$(git -C "$worktree" status --porcelain)" ] || die "uncommitted changes; commit them first"

cd "$worktree"

RESERVATION_FILE="${LOCK_FILE%.lock}.reserved"
RESERVATION_MINUTES=20
conflicted=0

# Reservation file: "<branch> <expiry as unix seconds>". Only the reserving branch removes it.
reservation_branch() { [ -f "$RESERVATION_FILE" ] && read -r held _ < "$RESERVATION_FILE" && echo "$held"; true; }
clear_own_reservation() {
    if [ "$(reservation_branch)" = "$branch" ]; then rm -f "$RESERVATION_FILE"; fi
}
# Every exit except a repeated rebase conflict gives the reservation up (landed, failed, interrupted).
trap '[ "$conflicted" = 1 ] || clear_own_reservation' EXIT

# Take the lock, honouring an unexpired reservation held by a different branch: release the lock
# so that the reserving branch can land, then retry.
while :; do
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        echo "land: waiting for the landing lock (another worktree is landing)..." >&2
        flock 9
    fi
    if [ -f "$RESERVATION_FILE" ]; then
        read -r held expiry < "$RESERVATION_FILE" || true
        if [ -z "${expiry:-}" ] || [ "$expiry" -le "$(date +%s)" ] 2>/dev/null; then
            rm -f "$RESERVATION_FILE"
        elif [ "$held" != "$branch" ]; then
            exec 9>&-
            echo "land: waiting for reservation of $held (expires in $((expiry - $(date +%s))) s)" >&2
            sleep 30
            continue
        fi
    fi
    break
done

echo "land: rebasing $branch onto main"
if ! git rebase main; then
    git rebase --abort
    conflicted=1
    echo "$branch $(( $(date +%s) + RESERVATION_MINUTES * 60 ))" > "$RESERVATION_FILE"
    echo "land: rebase onto main has conflicts; the rebase was aborted." >&2
    echo "land: $branch holds a $RESERVATION_MINUTES-minute reservation (other lands wait for it): rebase onto main now (git rebase main), resolve the conflicts, then re-run ./scripts/land." >&2
    exit 1
fi

if [ "$(git rev-parse main)" = "$(git rev-parse HEAD)" ]; then
    die "nothing to land: $branch is identical to main"
fi

candidate=$(git rev-parse HEAD)
if [ ! -e "$LAND_WORKTREE/.git" ]; then
    git worktree add --detach "$LAND_WORKTREE" "$candidate"
fi
echo "land: gates run in $LAND_WORKTREE on $(git rev-parse --short "$candidate")"
git -C "$LAND_WORKTREE" checkout --detach --force "$candidate"
git -C "$LAND_WORKTREE" clean -fdq -e /target
cd "$LAND_WORKTREE"

echo "land: gate: cargo fmt --all --check"
cargo fmt --all --check
echo "land: gate: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings
echo "land: gate: cargo test --workspace"
cargo test --workspace
echo "land: gate: ./scripts/check-features --no-run-examples"
./scripts/check-features --no-run-examples
cd "$worktree"

# main moved while the gates ran only if someone bypassed the lock; refuse rather than land untested code.
git merge-base --is-ancestor main "$candidate" || die "main moved during the gates; run ./scripts/land again"

if [ "$dry_run" = 1 ]; then
    echo "land: dry run: gates passed for $(git rev-parse --short "$candidate"); main not modified"
    exit 0
fi

echo "land: fast-forwarding main"
git -C "$MAIN_CHECKOUT" merge --ff-only "$candidate"
echo "land: landed $(git -C "$MAIN_CHECKOUT" log -1 --format='%h %s' main)"
